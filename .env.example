NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OpenTelemetry / OTLP Tracing (Optional for Grafana Cloud in later phase)
# OTEL_SERVICE_NAME=clinic-flow
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-0.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64-instance-id:token>

# Grafana Loki (Log Aggregation)
# Set LOKI_HOST to http://localhost:3100 to push logs directly to local Loki
LOKI_HOST=http://localhost:3100
LOKI_APP_NAME=clinic-flow
LOG_LEVEL=info
# LOKI_TENANT_ID=your-tenant-id # Optional for multi-tenant or Grafana Cloud
# LOKI_BASIC_AUTH_USER=your-user # Optional for Grafana Cloud
# LOKI_BASIC_AUTH_PASSWORD=your-key # Optional for Grafana Cloud

# Grafana Pyroscope (Continuous Profiling)
PYROSCOPE_ENABLED=true
PYROSCOPE_SERVER_ADDRESS=http://localhost:4040
PYROSCOPE_APPLICATION_NAME=clinic-flow
# PYROSCOPE_BASIC_AUTH_USER=your-user # Optional for Grafana Cloud
# PYROSCOPE_BASIC_AUTH_PASSWORD=your-key # Optional for Grafana Cloud

